# Signal configuration. Copy to .env (gitignored) and fill in real values.
# In production these are supplied by the systemd unit, not this file.

PORT=3002
NODE_ENV=development

# SQLite content database (surveys, teams, responses). Keep it out of the Git
# working tree in production.
DB_PATH=./data/signal.db

# Base URL used to build shareable, anonymous survey links (/s/<code>).
APP_BASE_URL=http://localhost:3002

# --- Central auth hub (@suite/auth-client) -------------------------------
# Sign-in is delegated to the Sprint Suite hub; Signal owns no login code.
APP_NAME=signal
HUB_BASE_URL=https://sprintsuite.uk
# Signal's per-app hub API key (from ~/suite-app-keys.txt on the prod box).
HUB_API_KEY=replace-with-HUB_API_KEY_SIGNAL
# Cookie domain for the local app session. Leave UNSET in local dev (localhost);
# set to the app's own domain in production (e.g. signal.sprintsuite.uk).
COOKIE_DOMAIN=
# Local app-session store: maps the session cookie to a central hub session.
APP_SESSIONS_DB=./data/signal-sessions.db
