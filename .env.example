# Signal configuration. Copy to .env (gitignored) and fill in real values.
# In production these are supplied by the systemd unit, not this file.

PORT=3002
NODE_ENV=development

# Session cookie signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

# SQLite database file. Keep it out of the Git working tree in production.
DB_PATH=./data/signal.db

# Base URL used to build email verification / password reset links.
APP_BASE_URL=http://localhost:3002

# Email transport. 'log' writes the message (and link) to the server log.
# Swap to 'smtp' or 'api' in v1.1 when a transport is provisioned.
MAIL_TRANSPORT=log

# Per-account brute-force lockout.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
